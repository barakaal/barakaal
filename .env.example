# Application
APP_NAME="AI Dropship Company OS"
DEBUG=false
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
LOG_LEVEL=INFO

# Database
POSTGRES_USER=dropship
POSTGRES_PASSWORD=dropship_secret_change_me
POSTGRES_DB=dropship_os
DATABASE_URL=postgresql+asyncpg://dropship:dropship_secret_change_me@localhost:5432/dropship_os

# Redis
REDIS_URL=redis://localhost:6379/0

# AI Providers (au moins un requis pour les agents IA)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security - Mode de sécurité
HUMAN_APPROVAL_REQUIRED=true
MAX_AUTO_SPEND_USD=0.0

# Marketplace APIs (optionnel au MVP - mode mock si absent)
# Amazon PA-API 5.0
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_REGION=us-east-1

# AliExpress DS API
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# eBay Browse API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# TikTok for Business API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Scheduler
WEEKLY_WORKFLOW_CRON="0 9 * * 1"
